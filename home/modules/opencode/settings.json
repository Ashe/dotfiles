{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "snapshots": true,
  "formatter": {
    "nixfmt": {
      "command": [
        "nixfmt",
        "$FILE"
      ],
      "extensions": [
        ".nix"
      ]
    },
    "rustfmt": {
      "command": [
        "rustfmt",
        "$FILE"
      ],
      "extensions": [
        ".rs"
      ]
    },
    "clang-format": {
      "command": [
        "clang-format",
        "-i",
        "$FILE"
      ],
      "extensions": [
        ".c",
        ".cc",
        ".cpp",
        ".cxx",
        ".h",
        ".hpp"
      ]
    },
    "fourmolu": {
      "command": [
        "fourmolu",
        "-i",
        "$FILE"
      ],
      "extensions": [
        ".hs"
      ]
    },
    "stylua": {
      "command": [
        "stylua",
        "$FILE"
      ],
      "extensions": [
        ".lua"
      ]
    },
    "taplo": {
      "command": [
        "taplo",
        "format",
        "$FILE"
      ],
      "extensions": [
        ".toml"
      ]
    },
    "yq": {
      "command": [
        "yq",
        "-i",
        ".",
        "$FILE"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    },
    "jq": {
      "command": [
        "sh",
        "-c",
        "jq . \"$1\" > \"$1\".tmp && mv \"$1\".tmp \"$1\"",
        "jq",
        "$FILE"
      ],
      "extensions": [
        ".json"
      ]
    },
    "xmllint": {
      "command": [
        "xmllint",
        "--format",
        "--output",
        "$FILE",
        "$FILE"
      ],
      "extensions": [
        ".xml",
        ".xsd"
      ]
    },
    "google-java-format": {
      "command": [
        "google-java-format",
        "--replace",
        "$FILE"
      ],
      "extensions": [
        ".java"
      ]
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "basename *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cat *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cut *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "dirname *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "du *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "file *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git blame *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git grep *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "grep *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "head *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "jj diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "jj file list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "jj file show *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "jj log *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "jj show *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "jj st *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "jj status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pwd *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "readlink *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "realpath *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rg *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sort *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "stat *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tail *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "type *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "uniq *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "wc *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "which *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo clippy *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo check *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo build *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo run *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo test *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo-mutants *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo mutants *",
      "effect": "allow"
    }
  ]
}
