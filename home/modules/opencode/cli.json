{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.4
  },
  "session": {
    "permissions": "prompt",
    "sidebar": "show",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true,
  "terminal": {
    "title": true,
    "copy": "select"
  }
}
